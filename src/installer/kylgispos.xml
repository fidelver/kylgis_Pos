<project>
    <shortName>kylgispos</shortName>
    <fullName>KylGis POS</fullName>
    <version>1.0</version>
    <installerFilename>${product_shortname}-${platform_name}-installer.${platform_exec_suffix}</installerFilename>
    <readmeFile>README</readmeFile>
    <licenseFile>licensing/KylGis POS Notice.txt</licenseFile>
    <leftImage>v_logo_dark.png</leftImage>
    <logoImage>kylgispos.png</logoImage>
    <splashImage>kylgispos_splash_dark.png</splashImage>
    <wmImage>kylgispos.png</wmImage>
    <allowLanguageSelection>1</allowLanguageSelection>
    <componentList>
        <component>
            <name>default</name>
            <description>Default Component</description>
            <canBeEdited>1</canBeEdited>
            <selected>1</selected>
            <show>1</show>
            <desktopShortcutList>
                <shortcut>
                    <comment>KylGis POS Punto de Venta Táctil</comment>
                    <exec>sh ${installdir}/start.sh</exec>
                    <icon>${installdir}/kylgispos.png</icon>
                    <name>KylGis POS</name>
                    <noPinToStart>0</noPinToStart>
                    <path>${installdir}</path>
                    <platforms>windows</platforms>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/start.bat</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon>${installdir}/kylgispos.ico</windowsIcon>
                    <windowsPath>${installdir}</windowsPath>
                </shortcut>
            </desktopShortcutList>
            <folderList>
                <folder>
                    <description>Program Files</description>
                    <destination>${installdir}</destination>
                    <name>programfiles</name>
                    <platforms>all</platforms>
                    <distributionFileList>
                        <distributionDirectory>
                            <origin>../../target/reports</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../../target/locales</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../../target/licensing</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../../target/lib</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../../target/Bonus</origin>
                            <onPackingFilterList>
                                <fileNameFilter>
                                    <logic>does_not_match</logic>
                                    <pattern>Thumbs.db</pattern>
                                </fileNameFilter>
                            </onPackingFilterList>
                        </distributionDirectory>
                        <distributionFile>
                            <origin>../../target/start.bat</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../../target/configure.bat</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../../target/kylgispos.jar</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>kylgispos_splash_dark.png</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>kylgispos.png</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>kylgispos.ico</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>window.logo.png</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>README_Locales.txt</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>README</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../../target/configure.sh</origin>
                        </distributionFile>
                        <distributionFile>
                            <origin>../../target/start.sh</origin>
                        </distributionFile>
                        <distributionDirectory>
                            <origin>../../target/Configs</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>../../target/Templates</origin>
                        </distributionDirectory>
                        <distributionDirectory>
                            <origin>helper</origin>
                        </distributionDirectory>
                        <distributionFile>
                            <origin>template.Ticket.A4_Beta.vm</origin>
                        </distributionFile>
                    </distributionFileList>
                    <actionList>
                        <runProgram>
                            <program>${installdir}/helper/fix-unix-permissions.sh</program>
                            <programArguments>"${installdir}"</programArguments>
                            <ruleList>
                                <platformTest>
                                    <type>unix</type>
                                </platformTest>
                            </ruleList>
                        </runProgram>
                    </actionList>
                </folder>
                <folder>
                    <description>DEB1</description>
                    <destination>/usr/share/icons</destination>
                    <name>kylgisposicon</name>
                    <platforms>linux linux-x64 linux-arm64 linux-arm32 linux-ia64 linux-ppc linux-s390 linux-s390x</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>kylgispos.png</origin>
                        </distributionFile>
                    </distributionFileList>
                    <actionList>
                        <changePermissions>
                            <files>/usr/share/icons/kylgispos.png</files>
                            <permissions>0644</permissions>
                        </changePermissions>
                    </actionList>
                </folder>
                <folder>
                    <description>DEB2</description>
                    <destination>/usr/share/applications</destination>
                    <name>kylgisposdesktop</name>
                    <platforms>linux linux-x64 linux-arm64 linux-arm32 linux-ia64 linux-ppc linux-s390 linux-s390x</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>kylgispos.desktop</origin>
                        </distributionFile>
                    </distributionFileList>
                    <actionList>
                        <changePermissions>
                            <files>/usr/share/applications/kylgispos.desktop</files>
                            <permissions>0644</permissions>
                        </changePermissions>
                    </actionList>
                </folder>
                <folder>
                    <description>DEB3</description>
                    <destination>/usr/bin/</destination>
                    <name>kylgisposexec</name>
                    <platforms>linux linux-x64 linux-arm64 linux-arm32 linux-ia64 linux-ppc linux-s390 linux-s390x</platforms>
                    <distributionFileList>
                        <distributionFile>
                            <origin>kylgispos</origin>
                        </distributionFile>
                    </distributionFileList>
                    <actionList>
                        <substitute>
                            <encoding>utf-8</encoding>
                            <files>/usr/bin/kylgispos</files>
                            <type>exact</type>
                            <substitutionList>
                                <substitution>
                                    <pattern>@@KYLGIS_INSTALLDIR@@</pattern>
                                    <value>${installdir}</value>
                                </substitution>
                            </substitutionList>
                        </substitute>
                        <changePermissions>
                            <files>/usr/bin/kylgispos</files>
                            <permissions>0755</permissions>
                        </changePermissions>
                    </actionList>
                </folder>
            </folderList>
            <startMenuShortcutList>
                <startMenuShortcut>
                    <comment>Punto de Venta Táctil</comment>
                    <name>KylGis POS</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/start.bat</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon>${installdir}/kylgispos.ico</windowsIcon>
                    <windowsPath>${installdir}</windowsPath>
                </startMenuShortcut>
                <startMenuShortcut>
                    <comment>Configure KylGis POS</comment>
                    <name>Configure</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/configure.bat</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon>${installdir}/kylgispos.ico</windowsIcon>
                    <windowsPath>${installdir}</windowsPath>
                </startMenuShortcut>
                <startMenuFileShortcut>
                    <comment>Images you can use in KylGis POS</comment>
                    <filePath>${installdir}/Bonus</filePath>
                    <name>Bonus</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsIcon></windowsIcon>
                </startMenuFileShortcut>
                <startMenuFileShortcut>
                    <comment>Modify KylGis POS languages</comment>
                    <filePath>${installdir}/locales</filePath>
                    <name>Locales</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsIcon></windowsIcon>
                </startMenuFileShortcut>
                <startMenuShortcut>
                    <comment>Uninstall ${product_fullname}</comment>
                    <name>Uninstall ${product_fullname}</name>
                    <runAsAdmin>0</runAsAdmin>
                    <runInTerminal>0</runInTerminal>
                    <windowsExec>${installdir}/${uninstallerName}.exe</windowsExec>
                    <windowsExecArgs></windowsExecArgs>
                    <windowsIcon></windowsIcon>
                    <windowsPath>${installdir}/</windowsPath>
                </startMenuShortcut>
            </startMenuShortcutList>
        </component>
    </componentList>
    <preInstallationActionList>
        <autodetectJava>
            <abortOnError>0</abortOnError>
            <customErrorMessage>Java JRE not found on your machine. Install the correct Java JRE runtime and then continue with install.</customErrorMessage>
            <explanation>Checking for Java JRE</explanation>
            <progressText>Searching....</progressText>
            <promptUser>1</promptUser>
            <selectionOrder>newest</selectionOrder>
            <onErrorActionList>
                <showInfo>
                    <explanation>When done...
Please use the JRE 1.8 version located in your Windows\ folder</explanation>
                    <text>Couldn't find Java JRE runtime on your machine!
Opening the Java website for you

Install the correct Java JRE runtime for your machine

Then continue with KylGis POS installation.</text>
                </showInfo>
                <launchBrowser>
                    <url>http://www.java.com</url>
                </launchBrowser>
            </onErrorActionList>
            <validVersionList>
                <validVersion>
                    <bitness></bitness>
                    <maxVersion>1.8</maxVersion>
                    <minVersion>1.8</minVersion>
                    <requireJDK>0</requireJDK>
                    <vendor>sun</vendor>
                </validVersion>
            </validVersionList>
        </autodetectJava>
    </preInstallationActionList>
    <postInstallationActionList>
        <launchBrowser>
            <url>${installdir}/helper/post-install.html</url>
        </launchBrowser>
    </postInstallationActionList>
    <cdromDirectory>${product_shortname}-cdrom</cdromDirectory>
    <componentsDirectory>${product_shortname}-components</componentsDirectory>
    <createOsxBundleZip>1</createOsxBundleZip>
    <description>KylGis POS Punto de Venta Táctil</description>
    <enableRollback>1</enableRollback>
    <enableTimestamp>1</enableTimestamp>
    <licenseFileEncoding>utf-8</licenseFileEncoding>
    <nativePackageName>kylgispos</nativePackageName>
    <outputDirectory>../../target/installers</outputDirectory>
    <productComments>KylGis POS Punto de Venta Táctil</productComments>
    <productContact>https://pos.kylgis.com</productContact>
    <productUrlHelpLink>https://pos.kylgis.com</productUrlHelpLink>
    <productUrlInfoAbout>https://pos.kylgis.com</productUrlInfoAbout>
    <readmeFileEncoding>utf-8</readmeFileEncoding>
    <release>1.0</release>
    <requireInstallationByRootUser>1</requireInstallationByRootUser>
    <saveRelativePaths>1</saveRelativePaths>
    <splashScreenDelay>4</splashScreenDelay>
    <style>custom</style>
    <summary>POS</summary>
    <vendor>KylGis POS</vendor>
    <windowsExecutableIcon>kylgispos.ico</windowsExecutableIcon>
    <windowsResourceComments>KylGis POS Punto de Venta Táctil - software libre bajo GNU GPL 3</windowsResourceComments>
    <windowsResourceFileDescription>KylGis POS executable</windowsResourceFileDescription>
    <windowsResourceFileVersion>1.0.0.0</windowsResourceFileVersion>
    <windowsResourceInternalName>KylGis POS</windowsResourceInternalName>
    <windowsResourceLegalTrademarks>KylGis POS</windowsResourceLegalTrademarks>
    <windowsUninstallerExecutableIcon>kylgispos.ico</windowsUninstallerExecutableIcon>
    <parameterList>
        <directoryParameter>
            <name>installdir</name>
            <description>Installer.Parameter.installdir.description</description>
            <explanation>Installer.Parameter.installdir.explanation</explanation>
            <value>${platform_install_prefix}/${product_shortname}</value>
            <default>${platform_install_prefix}/${product_shortname}</default>
            <allowEmptyValue>0</allowEmptyValue>
            <cliOptionName>prefix</cliOptionName>
            <mustBeWritable>1</mustBeWritable>
            <mustExist>0</mustExist>
            <width>30</width>
        </directoryParameter>
        <linkParameter>
            <name>open_browser</name>
            <title>Installation Help</title>
            <description>Open KylGis POS Website</description>
            <explanation>Get online help with your KylGis POS installation</explanation>
            <insertAfter>${installation_finished}${installation_finished}</insertAfter>
            <clickedActionList>
                <launchBrowser>
                    <url>https://pos.kylgis.com</url>
                </launchBrowser>
            </clickedActionList>
        </linkParameter>
    </parameterList>
    <platformOptionsList>
        <platformOptions>
            <description>KylGis POS Punto de Venta Táctil</description>
            <platform>deb</platform>
            <release>1</release>
            <summary>POS</summary>
            <vendor>KylGis POS</vendor>
        </platformOptions>
        <platformOptions>
            <platform>windows</platform>
        </platformOptions>
        <platformOptions>
            <platform>linux</platform>
        </platformOptions>
        <platformOptions>
            <platform>osx</platform>
        </platformOptions>
    </platformOptionsList>
    <readmeFileList>
        <readmeFile>
            <code>en</code>
            <encoding>utf-8</encoding>
            <file>README</file>
        </readmeFile>
    </readmeFileList>
    <slideShowImageList>
        <slideShowImage>
            <path>kylgispos_logo_500_222.png</path>
        </slideShowImage>
    </slideShowImageList>
</project>

