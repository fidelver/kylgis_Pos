<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="voucher" pageWidth="595" pageHeight="300" columnWidth="535"
              leftMargin="30" rightMargin="30" topMargin="20" bottomMargin="20">
    <parameter name="CUSTOMER_NAME" class="java.lang.String"/>
    <parameter name="LOGO" class="java.awt.Image"/>
    <parameter name="CODE" class="java.lang.String"/>
    <parameter name="ISSUED" class="java.util.Date"/>
    <parameter name="VALUE" class="java.lang.Double"/>
    <parameter name="EXPIRY" class="java.lang.String"/>

    <title>
        <band height="210">
            <image onErrorType="Blank">
                <reportElement x="0" y="0" width="90" height="55"/>
                <imageExpression><![CDATA[$P{LOGO}]]></imageExpression>
            </image>
            <textField>
                <reportElement x="105" y="5" width="300" height="30"/>
                <textElement verticalAlignment="Middle">
                    <font size="20" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$R{label.title}]]></textFieldExpression>
            </textField>
            <textField pattern="dd/MM/yyyy HH:mm" isBlankWhenNull="true">
                <reportElement x="405" y="10" width="130" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA[$P{ISSUED}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="75" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="75" width="415" height="20"/>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="105" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <text><![CDATA[Código]]></text>
            </staticText>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="105" width="415" height="24"/>
                <textElement><font size="14" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{CODE}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="0" y="145" width="120" height="25"/>
                <textElement><font size="12" isBold="true"/></textElement>
                <text><![CDATA[Valor]]></text>
            </staticText>
            <textField pattern="¤ #,##0.00" isBlankWhenNull="true">
                <reportElement x="120" y="140" width="200" height="35"/>
                <textElement><font size="22" isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$P{VALUE}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="0" y="175" width="120" height="20"/>
                <textElement><font isBold="true"/></textElement>
                <textFieldExpression><![CDATA[$R{label.expiry}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="120" y="175" width="415" height="20"/>
                <textFieldExpression><![CDATA[$P{EXPIRY}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="200" width="535" height="1"/>
            </line>
        </band>
    </title>
</jasperReport>
