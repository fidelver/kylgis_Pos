report = new com.mx.kylgis.pos.reports.PanelReportBean();

report.setTitleKey("Menu.Voucher");
report.setReport("/com/mx/kylgis/pos/reports/vouchers");
report.setResourceBundle("com/mx/kylgis/pos/reports/vouchers_messages");

// One row per voucher and receipt; dates and ticket number are contextual.
// The date filter is applied to the same receipt rows used for the totals.
report.setSentence("SELECT payments.VOUCHER AS NAME, " +
        "MIN(receipts.DATENEW) AS STARTDATE, MAX(receipts.DATENEW) AS ENDDATE, " +
        "SUM(payments.TOTAL) AS TOTAL, " +
        "CAST(tickets.TICKETID AS CHAR) AS TICKETID, " +
        "payments.RECEIPT AS RECEIPT " +
        "FROM payments " +
        "JOIN receipts ON payments.RECEIPT = receipts.ID " +
        "JOIN tickets ON tickets.ID = receipts.ID " +
        "WHERE payments.VOUCHER IS NOT NULL AND payments.VOUCHER <> '' " +
        "AND payments.VOUCHER <> '0' AND ?(QBF_FILTER) " +
        "GROUP BY payments.VOUCHER, payments.RECEIPT, tickets.TICKETID " +
        "ORDER BY STARTDATE DESC");

report.addParameter("receipts.DATENEW");
report.addParameter("receipts.DATENEW");

paramdates = new com.mx.kylgis.pos.reports.JParamsDatesInterval();
paramdates.setStartDate(com.mx.kylgis.pos.beans.DateUtils.getToday());
paramdates.setEndDate(com.mx.kylgis.pos.beans.DateUtils.getTodayMinutes());
report.addQBFFilter(paramdates);

report.addField("NAME", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("STARTDATE", com.mx.kylgis.pos.data.loader.Datas.TIMESTAMP);
report.addField("ENDDATE", com.mx.kylgis.pos.data.loader.Datas.TIMESTAMP);
report.addField("TOTAL", com.mx.kylgis.pos.data.loader.Datas.DOUBLE);
report.addField("TICKETID", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("RECEIPT", com.mx.kylgis.pos.data.loader.Datas.STRING);

report;