report = new com.mx.kylgis.pos.reports.PanelReportBean();

report.setTitleKey("Menu.CategorySales1");
report.setReport("/com/mx/kylgis/pos/reports/sales_categorysales_1");
report.setResourceBundle("com/mx/kylgis/pos/reports/sales_messages");

report.setSentence("SELECT " +
        "MIN(R.datenew) AS datenew, " +
        "COALESCE(C.id, CASE WHEN TL.price < 0 THEN '__DISCOUNT__' ELSE '__NOPRODUCT__' END) AS CATID, " +
        "CASE WHEN C.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE C.name END AS CATNAME, " +
        "CASE WHEN C.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE COALESCE(C_1.name, C.name) END AS PARENTCAT, " +
        "CASE WHEN P.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE P.name END AS PRODNAME, " +
        "SUM(TL.price * TL.units) AS BASE, " +
        "SUM((TL.price * TL.units) * TX.rate) AS AMOUNT, " +
        "SUM((TL.price + (TL.price * TX.rate)) * TL.units) AS TOTAL, " +
        "SUM(CASE WHEN TL.product IS NULL AND TL.price < 0 THEN 0 ELSE TL.units END) AS UNITS " +
    "FROM ticketlines TL " +
        "INNER JOIN taxes TX ON TL.taxid = TX.id " +
        "INNER JOIN tickets T ON TL.ticket = T.id " +
        "INNER JOIN receipts R ON T.id = R.id " +
        "LEFT JOIN products P ON TL.product = P.id " +
        "LEFT JOIN categories C ON P.category = C.id " +
        "LEFT JOIN categories C_1 ON C_1.id = C.parentid " +
    "WHERE ?(QBF_FILTER) " +
    "GROUP BY COALESCE(C.id, CASE WHEN TL.price < 0 THEN '__DISCOUNT__' ELSE '__NOPRODUCT__' END), " +
        "CASE WHEN C.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE C.name END, " +
        "CASE WHEN C.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE COALESCE(C_1.name, C.name) END, " +
        "P.id, CASE WHEN P.id IS NULL AND TL.price < 0 THEN '__DISCOUNT__' ELSE P.name END " +
    "ORDER BY PARENTCAT, CATNAME, PRODNAME");

report.addParameter("R.DATENEW");
report.addParameter("R.DATENEW");

paramdates = new com.mx.kylgis.pos.reports.JParamsDatesInterval();
paramdates.setStartDate(com.mx.kylgis.pos.beans.DateUtils.getToday());
paramdates.setEndDate(com.mx.kylgis.pos.beans.DateUtils.getTodayMinutes());
report.addQBFFilter(paramdates);

report.addParameter("C.id");
report.addQBFFilter(new com.mx.kylgis.pos.ticket.CategoryFilter());

report.addField("DATENEW", com.mx.kylgis.pos.data.loader.Datas.TIMESTAMP);
report.addField("CATID", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("CATNAME", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("PARENTCAT", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("PRODNAME", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("BASE", com.mx.kylgis.pos.data.loader.Datas.DOUBLE);
report.addField("AMOUNT", com.mx.kylgis.pos.data.loader.Datas.DOUBLE);
report.addField("TOTAL", com.mx.kylgis.pos.data.loader.Datas.DOUBLE);
report.addField("UNITS", com.mx.kylgis.pos.data.loader.Datas.DOUBLE);

report;