
report = new com.mx.kylgis.pos.reports.PanelReportBean();

report.setTitleKey("Menu.BarcodeSheet");
report.setReport("/com/mx/kylgis/pos/reports/labels_barcode_sheet");
report.setResourceBundle("com/mx/kylgis/pos/reports/labels_messages");

report.setSentence("SELECT "
                + "products.CODE, products.CODETYPE, products.NAME, "
                + "categories.ID AS CATEGORY, "
                + "categories.NAME AS CATEGORYNAME "
                + "FROM products LEFT OUTER JOIN categories ON products.CATEGORY = categories.ID "
                + "LEFT OUTER JOIN uom uom ON products.UOM = uom.ID "
                + "WHERE ?(QBF_FILTER) "
                + "ORDER BY categories.NAME, products.NAME");

report.addParameter("products.NAME|products.CODE|products.REFERENCE|uom.ID|uom.NAME");
report.addParameter("products.CATEGORY");
report.addQBFFilter(new com.mx.kylgis.pos.ticket.WarehouseProductFilter());

report.addField("CODE", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("CODETYPE", com.mx.kylgis.pos.data.loader.Datas.STRING);
report.addField("NAME", com.mx.kylgis.pos.data.loader.Datas.STRING);

report;

