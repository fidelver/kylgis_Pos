            #end
        </line>
        <line></line>    
        <line>
            <text align ="left" bold="true" length="31">Descripción</text>
       </line>
       <line>    
             <text align ="left" bold="true" length="9">Precio</text>
            <text align ="center" bold="true" length="10">Cantidad</text>
            <text align ="right" bold="true" length="10">Importe</text>
        </line> 
        <line>
            <text>------------------------------------------</text>
        </line>   
        #foreach ($inventoryline in $inventoryrecord.getLines())
