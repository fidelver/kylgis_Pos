                <text align ="left">${inventoryline.printName()}</text></line> 
            <line><text align ="left" length="10">${inventoryline.printPrice()}</text>
                <text align ="center" length="8">x${inventoryline.printMultiply()}</text>
                <text align ="right" length="13">${inventoryline.printSubValue()}</text>
            </line> 
            #if ($inventoryline.productAttSetInstId)
                <line><text align ="left" length="31">${inventoryline.productAttSetInstDesc}</text></line>
            #end
        #end
        <line><text>------------------------------------------</text></line>   
        <line></line>
        <line>
            <text align ="left" bold="true" length="10">Totales :</text>
            <text align ="center" bold="true" length="8">${inventoryrecord.printTotalArticles()}</text>
            <text align ="right" bold="true" length="13">${inventoryrecord.printSubTotal()}</text>
        </line>
        <line></line>            
        <line><text align="center" bold="true" length="31">Conserva Este Comprobante</text></line>  
